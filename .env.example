# Copy to .env.local. Every key is optional: without them Luka runs fully
# offline (local storage, built-in recipe library, no AI features).

# Server-side only. Turns on Claude: automatic new recipes for thin cuisines,
# "Generate by country", "Paste a recipe" and "Scan fridge photo".
ANTHROPIC_API_KEY=
# Optional: model used by the AI gateway (default claude-opus-5-5).
# claude-sonnet-5-5 or claude-haiku-5-5 cost less per recipe.
ANTHROPIC_MODEL=
# Optional: new AI recipe batches each person can request per day (admins are unlimited).
AI_DAILY_LIMIT=10

# Supabase: accounts, cloud sync and shared households (see docs/SUPABASE.md).
# Public by design; row-level security in supabase/migrations protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Show "Continue with Google" once the provider is enabled in Supabase.
NEXT_PUBLIC_AUTH_GOOGLE=false

# ── Ask LUKA chat: Groq free tier first (no card), Claude if Groq is busy ──
# GROQ_API_KEY=            # console.groq.com; turn on Zero Data Retention under Data Controls
# GROQ_MODEL=openai/gpt-oss-120b
# SOUSCHEF_PROVIDERS=groq,anthropic

# ── Recipe embeddings: Cloudflare Workers AI, bge-m3 (free daily allocation, no card) ──
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_AI_TOKEN=     # API token with only the "Workers AI: Read" permission

# ── Batch generation (weekly gap-finder, imports) on your own Ollama ──
# BATCH_LLM=ollama
# OLLAMA_BASE_URL=https://ollama.your-domain.example   # https only; never expose port 11434 directly
# OLLAMA_API_KEY=          # bearer token your reverse proxy checks, or use Cloudflare Access:
# OLLAMA_ACCESS_CLIENT_ID=
# OLLAMA_ACCESS_CLIENT_SECRET=
# OLLAMA_MODEL=qwen3:14b

# ── Nearby grocers & restaurants: Geoapify free plan (no card), cached in Supabase ──
# GEOAPIFY_API_KEY=        # server-side only (never NEXT_PUBLIC_); the Supabase cache keeps use far under 3,000 credits/day

# ── Shop on Instacart (checkout handoff only) ──
# INSTACART_API_KEY=
# INSTACART_ENV=development   # "production" once Instacart approves the production key
