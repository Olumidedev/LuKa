# Copy to .env.local. Every key is optional: without them Luka runs fully
# offline (local storage, built-in recipe library, no AI features).

# Server-side only. Turns on Claude: automatic new recipes for thin cuisines,
# "Generate by country", "Paste a recipe" and "Scan fridge photo".
ANTHROPIC_API_KEY=
# Optional: model used by the AI gateway (default claude-opus-5-5).
# claude-sonnet-5-5 or claude-haiku-5-5 cost less per recipe.
ANTHROPIC_MODEL=
# Optional: new AI recipe batches each person can request per day (admins are unlimited).
AI_DAILY_LIMIT=10

# Supabase: accounts, cloud sync and shared households (see docs/SUPABASE.md).
# Public by design; row-level security in supabase/migrations protects the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Show "Continue with Google" once the provider is enabled in Supabase.
NEXT_PUBLIC_AUTH_GOOGLE=false
