# Copy to .env.local. Every key is optional: without them Luka runs fully
# offline (local storage, built-in recipe library, no AI features).

# Server-side only. Enables "Generate recipes with AI", "Paste a recipe" and "Scan fridge".
GEMINI_API_KEY=
# Model routed by the AI gateway (src/lib/ai/gateway.ts).
GEMINI_MODEL=gemini-3-flash

# Firebase web config (public by design; security comes from Firestore rules + App Check).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
